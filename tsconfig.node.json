{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true,
    "outDir": "out",
    "rootDir": ".",
    "paths": {
      "@electron/*": ["./electron/*"]
    }
  },
  "include": ["electron/**/*"]
}
